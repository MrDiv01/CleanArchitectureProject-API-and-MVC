@using EEWF.Domain.DTOs.Education;
@model EducationDto
@{
    ViewData["Title"] = "Index";
}

<div id="fh5co-about">
    <div class="container">
        <div class="row">
            <div class="col-md-6 animate-box">
                <h2>@Model.Name</h2>
                <p>@Model.Description</p>
            </div>
            <div style="display:flex;" class="col-md-6 education-image">
                <img style="height:250px" class="img-responsive" src="~/uploads/education/@Model.Image" alt="OOPS">
            </div>
        </div>
    </div>
