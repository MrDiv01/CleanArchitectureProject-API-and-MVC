@using EEWF.Domain.DTOs.Education;
@model List<EducationDto>
@{
    ViewData["Title"] = "Index";
}

<div id="fh5co-course">
	<div class="container">
		<div class="row">
			@foreach(EducationDto education in Model)
			{
			<div class="col-md-6 animate-box">
				<div class="course">
						<a asp-action="index" asp-controller="EducationInfo" asp-route-id="@education.EducationId" class="course-img" style="background-image: url(../uploads/education/@education.Image);">
					</a>
					<div class="desc">
							<h3><a asp-action="index" asp-controller="EducationInfo" asp-route-id="@education.EducationId">@education.Name</a></h3>
						<p>@education.Description</p>
							<span><a asp-action="index" asp-controller="EducationInfo" asp-route-id="@education.EducationId" class="btn btn-primary btn-sm btn-course">About</a></span>
					</div>
				</div>
			</div>
			}
		</div>
	</div>
</div>